# POSTGRES BAZA PODATAKA
POSTGRES_DB=artconnect # naziv baze
POSTGRES_USER=postgres # korisnik baze
POSTGRES_PASSWORD=change-me # lozinka baze, obavezno promijeniti
POSTGRES_HOST=db # adresa baze u docker okruženju
POSTGRES_PORT=5432 # port baze

# DJANGO BACKEND
DJANGO_SECRET_KEY=long-random-string # tajni ključ, obavezno promijeniti
DJANGO_DEBUG=True # debug način rada
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1 # dopuštene adrese 
DJANGO_LOCAL_PORT=8000 # django port